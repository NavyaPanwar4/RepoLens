# Copy this file to backend/.env and set your key before starting the API.
GROQ_API_KEY=your_groq_api_key_here

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local storage for persisted source snapshots and Chroma collections.
DATA_DIR=./data
CHROMA_PATH=./data/chroma

# Intake limits. Increase deliberately for trusted deployments only.
MAX_UPLOAD_BYTES=104857600
MAX_ZIP_MEMBERS=10000
MAX_ZIP_UNCOMPRESSED_BYTES=524288000
MAX_FILES_PER_REPO=5000
MAX_FILE_BYTES=1000000

# Optional API authentication. Leave blank to disable authentication.
API_KEYS=

# Optional integrations.
REDIS_URL=
GITHUB_TOKEN=

# Optional GitHub App integration.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=

# Real scanner integration (requires tools or container packages).
ENABLE_REAL_SCANNERS=false
TRUSTED_PROXY_COUNT=0
REQUEST_TIMEOUT_SECONDS=300

# Production deployment
ENVIRONMENT=development
